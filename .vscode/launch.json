{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Android (Pixel 10)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/mobile",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--android"],
      "console": "integratedTerminal"
    },
    {
      "name": "Debug Web (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8081",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
